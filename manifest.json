{
  "manifest_version": 3,
  "name": "Krillion Gemini Auto-Answer",
  "version": "1.0.0",
  "description": "Finds rare, high-scoring answers for Krillion using the Gemini API.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://krillion.io/*",
    "https://*.krillion.io/*",
    "https://playdaily.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Krillion Gemini Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://krillion.io/*",
        "https://*.krillion.io/*",
        "https://playdaily.org/krillion*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}